// Rule 1: Renamed system binary executed (MITRE ATT&CK T1036.003)
// Data source: Sysmon Event ID 1 (process creation) in the WindowsEvent table
// Sentinel scheduled analytics rule: runs every 5 minutes, looks back 30 minutes.
// The ingestion_time() filter handles late-arriving logs (measured: 9 min average,
// 17 min maximum) so each event is evaluated once, shortly after it arrives.
WindowsEvent
| where ingestion_time() > ago(6m)
| where EventID == 1
| extend Image = tostring(EventData.Image),
    OriginalFileName = tostring(EventData.OriginalFileName),
    ParentImage = tostring(EventData.ParentImage),
    CommandLine = tostring(EventData.CommandLine)
// Normalize both names: file name only, lower case, no ".exe"
| extend ImageName = tolower(extract(@"([^\\]+)$", 1, Image))
| extend ImageBase = trim_end(@"\.exe", ImageName),
    OrigBase = trim_end(@"\.exe", tolower(OriginalFileName))
// A: a commonly abused Windows tool running under a different name
// B: lsass.exe running from anywhere other than System32
| where (OrigBase in ("cmd","powershell","rundll32","mshta","wscript","cscript","certutil")
        and ImageBase != OrigBase)
    or (ImageName == "lsass.exe"
        and not(Image startswith @"C:\Windows\System32\"))
| project TimeGenerated, Computer, Image, OriginalFileName, ParentImage, CommandLine
